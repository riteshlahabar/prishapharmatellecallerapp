<?xml version="1.0" encoding="utf-8"?>
<!--
    The window Android paints before Flutter's first frame. It shows the same
    logo on the same pale ground as the Flutter splash that follows it
    (lib/features/splash), so the hand-off is invisible: without a drawable
    here the app opens on a white flash and then jumps to the brand.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
